{
  "name": "buildcraft",
  "version": "1.0.0",
  "description": "BuildCraft : crée de vrais serveurs Minecraft Bedrock (PowerNukkitX, PocketMine-MP) et laisse une IA coder, compiler et tester tes plugins.",
  "main": "app/main.js",
  "scripts": {
    "build": "esbuild src/renderer/app.js --bundle --minify --format=iife --target=chrome130 --outfile=app/dist/renderer.js",
    "start": "npm run build && electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "update-feed": "node scripts/update-feed.mjs",
    "installer-art": "node scripts/make-installer-art.mjs"
  },
  "author": "Maxence-P-dev",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "minisearch": "^7.2.0",
    "node-llama-cpp": "^3.22.1"
  },
  "devDependencies": {
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "codemirror": "^6.0.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "node-llama-cpp@3.22.1": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "productName": "BuildCraft",
  "build": {
    "appId": "com.buildcraft.app",
    "productName": "BuildCraft",
    "copyright": "© 2026 Maxence-P-dev",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json",
      "!node_modules/node-llama-cpp/bins/**/*",
      "node_modules/node-llama-cpp/bins/${os}-${arch}*/**/*",
      "!node_modules/node-llama-cpp/llama/localBuilds/**/*",
      "node_modules/node-llama-cpp/llama/localBuilds/${os}-${arch}*/**/*",
      "!node_modules/@node-llama-cpp/*/bins/**/*",
      "node_modules/@node-llama-cpp/${os}-${arch}*/bins/**/*",
      "!node_modules/@node-llama-cpp/*cuda*/**/*",
      "!node_modules/node-llama-cpp/llama/llama.cpp/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BuildCraft-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BuildCraft",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "BuildCraft-Setup.${ext}",
      "language": "1036",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/Maxence-P-dev/buildcraft/main/update/"
      }
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins",
      "node_modules/node-llama-cpp/llama/localBuilds",
      "node_modules/@node-llama-cpp/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Maxence-P-dev/buildcraft.git"
  },
  "homepage": "https://github.com/Maxence-P-dev/buildcraft"
}
